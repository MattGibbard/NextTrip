{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexttrip",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Lets Workers Builds run `wrangler preview` for pull requests. Previews don't inherit bindings,
  // so they name their own database here: nexttrip-preview, kept apart from the live
  // database so nothing done in a preview touches real data. The Worker creates its tables on
  // first use. Sign-in links show on the page instead of being emailed, so previews need no
  // Resend key; anyone with a preview link can sign in, but only ever sees test data.
  "previews": {
    "vars": { "DEV_LOGIN_LINKS": "1" },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "nexttrip-preview",
        "database_id": "2cf43de2-c62f-412b-9aa7-f7ef2c231444"
      }
    ]
  },
  // The Worker sees every request first (worker/pages.ts) so it can redirect the old address and keep
  // family links out of search. Anything that isn't a page or a built file gets 404.html with a 404.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // The live database, created in Western Europe (--location=weur). Location is fixed when a D1
  // database is created, so moving it means a new database plus an export and import.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "somewhereparty",
      "migrations_dir": "migrations"
    }
  ]
}
